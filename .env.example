# Exchange Rate API - Environment Variables
# Copy this file to .env and adjust values for local development

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# MailHog (local dev email)
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025

# Provider API Endpoints
PROVIDERS_EXCHANGE_RATE_API_BASEURL=https://api.exchangerate-api.com
PROVIDERS_OPEN_EXCHANGE_RATES_BASEURL=https://openexchangerates.com
